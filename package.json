{
  "name": "local-transcriber",
  "productName": "Local Transcriber",
  "version": "1.0.0",
  "description": "Private, offline video/audio transcription for Windows (faster-whisper + Next.js + Electron) with Arabic-first PDF export.",
  "author": "Local Transcriber",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/setup-python.mjs",
    "setup": "node scripts/setup-python.mjs",
    "setup:gpu": "node scripts/setup-python.mjs --gpu",
    "setup:cpu": "node scripts/setup-python.mjs --cpu",
    "dev": "node scripts/dev.mjs",
    "app": "next build frontend && electron .",
    "dev:ui": "next dev frontend --port 3123",
    "build:ui": "next build frontend",
    "build:backend": "node scripts/build-backend.mjs",
    "build": "npm run build:ui && npm run build:backend",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "doctor": "node scripts/doctor.mjs",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "lint": "npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "ffmpeg-static": "^5.2.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.localtranscriber.app",
    "productName": "Local Transcriber",
    "copyright": "Local Transcriber",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "frontend/out/**/*",
      "build/icon.png",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/transcriber-backend",
        "to": "backend/transcriber-backend",
        "filter": ["**/*"]
      },
      {
        "from": "node_modules/ffmpeg-static/",
        "to": "ffmpeg/",
        "filter": ["ffmpeg.exe", "ffmpeg", "LICENSE", "*.LICENSE"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LocalTranscriber-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Local Transcriber"
    }
  }
}
